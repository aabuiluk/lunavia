+
+  // Scroll to #anchors (react-router does not do it by itself).
+  useEffect(() => {
+    if (!hash) return
+    document.getElementById(hash.slice(1))?.scrollIntoView({ behavior: 'smooth' })
+  }, [pathname, hash])
+
+  // Menu open: lock page scroll, close on Escape, focus the close button.
+  useEffect(() => {
+    if (!menuOpen) return undefined
