+  }
+
+  .why__item {
+    padding: 22px 0;
+  }
+
+  .why__item--extra {
+    display: none;
+  }
+
+  .why__item:not(.why__item--extra) {
+    counter-increment: why;
+  }
+
+  .why__num {
+    font-size: 0;
+  }
+
+  .why__num::before {
+    content: counter(why, decimal-leading-zero);
+    font-size: 12px;
+  }
+
+  .why__item h4 {
+    font-size: 20px;
+  }
+
+  .why__item p {
+    font-size: 14px;
   }
 }
