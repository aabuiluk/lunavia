+  useEffect(() => {
+    const mq = window.matchMedia('(min-width: 861px)')
+    const onChange = (e) => e.matches && setMenuOpen(false)
+    mq.addEventListener('change', onChange)
+    return () => mq.removeEventListener('change', onChange)
+  }, [])
+
